# Archivo de ejemplo para configuración de entorno
# Copia este archivo como .env en la raíz del proyecto y configura tus valores

# Configuración de SQL Server
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=TuPasswordSeguro123!

# Configuración alternativa para desarrollo local
# SPRING_DATASOURCE_USERNAME=viarapida_user
# SPRING_DATASOURCE_PASSWORD=password123

# Configuración del servidor
# SERVER_PORT=8080

# Configuración de logging (opcional)
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_VIARAPIDA=DEBUG

# Notas:
# 1. Asegúrate de que SQL Server esté ejecutándose en puerto 1433
# 2. La base de datos 'web_via' debe existir
# 3. El usuario debe tener permisos de lectura/escritura en la base de datos
# 4. Para producción, usa credenciales más seguras y considera usar Azure SQL Database